# Example environment file (DO NOT put secrets in Git)
#
# Copy to `.env` and fill in your own values.
# Never commit `.env` or session strings.

# Telegram API credentials (from https://my.telegram.org)
API_ID=
API_HASH=

# Pyrogram user session string (generated via backend/generate_session.py)
SESSION_STRING=

# Optional: the app can scrape public channels without any backend.
# This backend exists only for listing joined/private channels.
